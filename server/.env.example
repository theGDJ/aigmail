# ---------------------------------------------------------------------------
# AI Mail Summarizer - backend environment
# Copy this file to server/.env and fill in your own values.
# NEVER commit server/.env (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Where the React app runs (used for CORS + post-login redirects)
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL (required) -------------------------------------------------
# <user>:<password> are YOUR local Postgres credentials.
DATABASE_URL=postgresql://dheerjg@localhost:5432/ai_mail_summarizer?schema=public

# --- Sessions / security (required) ---------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# 30 days in milliseconds
SESSION_TTL_MS=2592000000
COOKIE_SECURE=false

# --- Google OAuth 2.0 + Gmail API (optional) ------------------------------
# Create these at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly:
#   http://localhost:4000/auth/google/callback
# Enable the "Gmail API" for the project, then fill both values in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- OpenAI (optional) ----------------------------------------------------
# When empty the app uses the built-in deterministic local analysis engine,
# so every feature still works offline (demo mode).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=45000

# --- Feature flags --------------------------------------------------------
# Allow the password-free "demo account" login button (seeded mailbox).
ENABLE_DEMO_LOGIN=true
# Allow the mock email provider (used by the demo account + tests).
ENABLE_MOCK_PROVIDER=true
