# Client environment (all values are optional - the defaults work in development).
#
# In development the Vite dev server proxies /api, /auth and /health to the
# Express server on http://localhost:4000 (see vite.config.js), which keeps the
# session cookie first-party. Leave VITE_API_URL empty to use that proxy.

# Point the client at a different backend (for example a deployed API).
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=
